{
  "name": "StaffShift",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche",
        "largo",
        "TL1",
        "TL2",
        "N1",
        "N2",
        "V",
        "LIBRE",
        "N"
      ]
    },
    "hora_inicio": {
      "type": "string",
      "description": "Hora de inicio del turno (ej: 08:00)"
    },
    "hora_fin": {
      "type": "string",
      "description": "Hora de t\u00e9rmino del turno (ej: 16:00)"
    },
    "area": {
      "type": "string"
    },
    "grupo_turno": {
      "type": "string",
      "enum": [
        "profesionales_salud",
        "cuidadoras",
        "tens"
      ],
      "default": "profesionales_salud",
      "description": "Grupo al que pertenece este turno"
    },
    "status": {
      "type": "string",
      "enum": [
        "programado",
        "presente",
        "ausente",
        "reemplazo",
        "licencia"
      ],
      "default": "programado"
    },
    "replacement_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "staff_name",
    "date",
    "shift_type"
  ]
}