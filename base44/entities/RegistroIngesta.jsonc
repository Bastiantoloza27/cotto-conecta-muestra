{
  "name": "RegistroIngesta",
  "type": "object",
  "x-admin-unrestricted-read": true,
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "turno": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ]
    },
    "tipo_comida": {
      "type": "string",
      "enum": [
        "desayuno",
        "colacion_manana",
        "almuerzo",
        "once",
        "hidratacion",
        "cena",
        "colacion_nocturna"
      ],
      "description": "Tipo de comida o momento de hidrataci\u00f3n registrada"
    },
    "porcion_consumida": {
      "type": "string",
      "enum": [
        "0",
        "1/4",
        "1/2",
        "3/4",
        "completo"
      ],
      "description": "Fracci\u00f3n del plato consumida"
    },
    "hidratacion": {
      "type": "string",
      "enum": [
        "ninguna",
        "poca",
        "adecuada",
        "buena"
      ],
      "description": "Nivel de hidrataci\u00f3n"
    },
    "encargada": {
      "type": "string"
    },
    "observaciones": {
      "type": "string"
    }
  },
  "required": [
    "resident_id",
    "date",
    "turno",
    "tipo_comida"
  ]
}