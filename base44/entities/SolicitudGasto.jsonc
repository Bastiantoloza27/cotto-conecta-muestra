{
  "name": "SolicitudGasto",
  "type": "object",
  "properties": {
    "solicitante_nombre": {
      "type": "string",
      "description": "Nombre del solicitante"
    },
    "solicitante_email": {
      "type": "string",
      "description": "Email del solicitante"
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la solicitud"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo del gasto"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "insumos",
        "traslado",
        "alimentacion",
        "mantenimiento",
        "capacitacion",
        "otros"
      ],
      "description": "Categor\u00eda del gasto"
    },
    "monto": {
      "type": "number",
      "description": "Monto solicitado en pesos chilenos"
    },
    "detalle": {
      "type": "string",
      "description": "Detalle adicional (opcional)"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "aprobada",
        "rechazada"
      ],
      "default": "pendiente",
      "description": "Estado de la solicitud"
    },
    "motivo_rechazo": {
      "type": "string",
      "description": "Motivo del rechazo (si aplica)"
    },
    "fecha_resolucion": {
      "type": "string",
      "description": "Fecha y hora de la resoluci\u00f3n del director (ISO string)"
    },
    "director_nombre": {
      "type": "string",
      "description": "Nombre del director que resolvi\u00f3"
    }
  },
  "required": [
    "solicitante_nombre",
    "fecha_solicitud",
    "motivo",
    "categoria",
    "monto"
  ]
}