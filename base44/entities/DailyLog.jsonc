{
  "name": "DailyLog",
  "type": "object",
  "x-admin-unrestricted-read": true,
  "properties": {
    "resident_id": {
      "type": "string",
      "description": "ID de la persona residente"
    },
    "resident_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string",
      "description": "Hora del registro"
    },
    "log_type": {
      "type": "string",
      "enum": [
        "cuidadora",
        "tens",
        "psicosocial"
      ],
      "default": "cuidadora",
      "description": "Tipo de bit\u00e1cora: cuidadora, TENS o Psicosocial"
    },
    "category": {
      "type": "string",
      "enum": [
        "alimentacion",
        "emocional",
        "sueno",
        "comportamiento",
        "actividad",
        "salud",
        "higiene",
        "social",
        "espiritual",
        "signos_vitales",
        "procedimiento",
        "medicacion",
        "curacion",
        "examen_fisico",
        "glucemia",
        "sondaje",
        "oxigenoterapia",
        "estado_animo",
        "vinculo_familiar",
        "interaccion_social",
        "duelo",
        "conducta",
        "autonomia_social",
        "proyecto_vida",
        "evaluacion_psicologica",
        "intervencion_social",
        "crisis",
        "otro"
      ],
      "default": "otro"
    },
    "mood": {
      "type": "string",
      "enum": [
        "muy_bien",
        "bien",
        "regular",
        "bajo",
        "critico"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del registro"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manana",
        "tarde",
        "noche"
      ]
    },
    "is_important": {
      "type": "boolean",
      "default": false
    },
    "registered_by": {
      "type": "string",
      "description": "Nombre del funcionario que registra"
    },
    "tags": {
      "type": "string",
      "description": "Etiquetas separadas por coma"
    }
  },
  "required": [
    "resident_id",
    "category",
    "description"
  ]
}