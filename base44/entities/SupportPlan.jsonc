{
  "name": "SupportPlan",
  "type": "object",
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Objetivo principal del plan"
    },
    "area": {
      "type": "string",
      "enum": [
        "autonomia",
        "salud",
        "social",
        "emocional",
        "espiritual",
        "comunicacion",
        "movilidad",
        "cognitivo",
        "otro"
      ]
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del plan y contexto"
    },
    "diagnostico_situacion": {
      "type": "string",
      "description": "Diagn\u00f3stico de la situaci\u00f3n actual del residente"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha meta para lograr el objetivo"
    },
    "revision_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de pr\u00f3xima revisi\u00f3n del plan"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "en_pausa",
        "logrado",
        "reformulado",
        "cerrado"
      ],
      "default": "activo"
    },
    "progress": {
      "type": "number",
      "description": "Porcentaje de avance 0-100"
    },
    "supports": {
      "type": "string",
      "description": "Apoyos y estrategias necesarias"
    },
    "profesionales_involucrados": {
      "type": "string",
      "description": "Profesionales del equipo participantes (separados por coma)"
    },
    "responsible": {
      "type": "string",
      "description": "Profesional responsable/coordinador del plan"
    },
    "evaluations": {
      "type": "string",
      "description": "Notas de evaluaci\u00f3n peri\u00f3dica"
    },
    "indicadores_logro": {
      "type": "string",
      "description": "Indicadores concretos para determinar el logro del objetivo"
    },
    "observations": {
      "type": "string"
    }
  },
  "required": [
    "resident_id",
    "title",
    "area"
  ]
}